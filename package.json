{
  "name": "lensforecast",
  "version": "0.1.0",
  "private": true,
  "description": "Physics-based photography simulator for informed gear and shooting decisions",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
